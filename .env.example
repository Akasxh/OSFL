# Copy to .env and fill in your key.
#
# OSFL runs FULLY OFFLINE by default with deterministic fallbacks. Setting an
# OpenAI key activates the LLM-backed language features:
#   - "you-voiced" message drafting from your persona skill files
#   - scenario advice answered as a sharper version of you
#   - free-text goal decomposition into a funnel
#   - natural-language intent routing in the orchestrator
#
# The Monte-Carlo / Bayesian engine never calls an LLM — it stays deterministic.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional operational settings (defaults shown):
# OSFL_STORE_PATH=data/store.json   # where the single JSON backend lives
# LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
